# EDUVERSE-UZ environment template
# Copy to a private deployment secret store. Never commit real values.
NODE_ENV=production
PORT=5000
HOST=127.0.0.1
DATABASE_URL=postgresql://eduverse_app:CHANGE_ME@127.0.0.1:5432/eduverse
CORS_ORIGINS=https://school.example.uz
TRUST_PROXY=1
JSON_BODY_LIMIT=1mb
LOG_LEVEL=info
EDUVERSE_ALLOW_PUBLIC_REGISTRATION=0
# Required for encrypted 2FA secrets. Generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=
# Optional Telegram delivery for account two-factor codes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Local demos only; never enable in production.
EDUVERSE_DEV_2FA_ECHO=0
# Google Gemini powers AI topics, tests and 3D when this key is set.
# Free key: https://aistudio.google.com/app/apikey — leave empty to use the
# built-in deterministic generator (works without any key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: works with any OpenAI-compatible endpoint (Ollama, OpenAI, Groq).
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=45000
# Optional: finds the exact YouTube lesson video by topic (or reuse the Gemini key).
YOUTUBE_API_KEY=
# Optional: embedded 3D models by topic.
SKETCHFAB_API_KEY=
# Set to 0 to disable awarding a grade to the end-of-lesson game winner.
EDUVERSE_ALLOW_AUTO_GRADING=1
