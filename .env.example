# EDUVERSE-UZ environment template
# Copy to a private deployment secret store. Never commit real values.
NODE_ENV=production
PORT=5000
HOST=127.0.0.1
DATABASE_URL=postgresql://eduverse_app:CHANGE_ME@127.0.0.1:5432/eduverse
CORS_ORIGINS=https://school.example.uz
TRUST_PROXY=1
JSON_BODY_LIMIT=1mb
LOG_LEVEL=info
EDUVERSE_ALLOW_PUBLIC_REGISTRATION=0
